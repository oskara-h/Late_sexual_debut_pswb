### Rubin-pooled predictions ###
pool_spline <- function(models, ages, name) {
  m <- length(models)

  predictions <- purrr::map_dfr(models, function(model) {
    pred <- marginaleffects::avg_predictions(
      model,
      variables = list(da_reported_or_assigned = ages),
      vcov = "HC3",
      conf_level = 0.95
    ) %>%
      as_tibble()

    if (!"std.error" %in% names(pred)) {
      if (!all(c("conf.low", "conf.high") %in% names(pred))) {
        stop("Missing prediction uncertainty.")
      }
      pred <- pred %>%
        mutate(std.error = (conf.high - conf.low) / (2 * qnorm(0.975)))
    }

    pred %>%
      select(da_reported_or_assigned, estimate, std.error)
  })

  predictions %>%
    group_by(da_reported_or_assigned) %>%
    summarise(
      q = mean(estimate),
      u = mean(std.error^2),
      b = if (m > 1) var(estimate) else 0,
      t_var = u + (1 + 1 / m) * b,
      lambda = if_else(t_var > 0 & b > 0, ((1 + 1 / m) * b) / t_var, 0),
      df = if_else(t_var > 0 & b > 0, (m - 1) / lambda^2, Inf),
      .groups = "drop"
    ) %>%
    mutate(ci = qt(0.975, df) * sqrt(t_var)) %>%
    transmute(
      da_reported_or_assigned,
      estimate = q,
      conf_low = q - ci,
      conf_high = q + ci,
      outcome = name
    )
}

