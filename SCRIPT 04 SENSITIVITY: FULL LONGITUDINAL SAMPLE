#### SAMPLE RESTRICTION ####
schools_followed_probsample_sens <- unique(uin_data_raw_probsample_sens$School1[!is.na(uin_data_raw_probsample_sens$School1)])
classes_followed_probsample_sens <- unique(uin_data_raw_probsample_sens$Class1[!is.na(uin_data_raw_probsample_sens$Class1)])

yin_partici5_only_probsample_sens <- uin_data_raw_probsample_sens %>%
  filter(
    !is.na(id),
