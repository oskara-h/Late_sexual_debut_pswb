plot_domain_spline <- function(data, fill_col, line_col, xlab = NULL) {
  ggplot(data, aes(x = da_reported_or_assigned, y = estimate)) +
    geom_ribbon(aes(ymin = conf_low, ymax = conf_high), fill = fill_col, alpha = 0.8) +
    geom_line(linewidth = 0.9, color = line_col) +
    geom_vline(
      data = contrast_lines,
      aes(xintercept = xintercept, colour = line_col),
      linetype = "dashed",
      linewidth = 1.2,
      show.legend = FALSE,
      inherit.aes = FALSE
    ) +
    scale_colour_identity() +
    facet_wrap(~ outcome, nrow = 1, scales = "free_y") +
    coord_cartesian(xlim = c(13, 28)) +
    scale_x_continuous(breaks = contrast_ages) +
    labs(x = xlab, y = NULL) +
    theme_classic() +
    theme(
      text = element_text(family = "Times New Roman", size = 18),
      strip.text = element_text(face = "bold"),
      strip.background = element_blank()
    )
}

