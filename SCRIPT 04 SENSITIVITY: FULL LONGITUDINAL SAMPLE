#### PRIMARY EXPOSURE VARIABLE CREATION ####
##### Deriving sexual debut age #####

yin_partici5_only_probsample_sens <- yin_partici5_only_probsample_sens %>%
  mutate(
    sexual_debut_t2 = if_else(between(as.numeric(SexEx2_5), 1, 22), as.numeric(SexEx2_5), NA_real_),
    sexual_debut_t3 = if_else(between(as.numeric(SexEx3_5), 1, 27), as.numeric(SexEx3_5), NA_real_),
    sexual_debut_t4 = if_else(between(as.numeric(SexEx4_5), 1, 33), as.numeric(SexEx4_5), NA_real_),
    sexual_debut_t5 = if_else(between(as.numeric(SexEx5_5), 1, 48), as.numeric(SexEx5_5), NA_real_),
    sexual_debut_age = coalesce(sexual_debut_t2, sexual_debut_t3, sexual_debut_t4, sexual_debut_t5)
  )

##### QC: Response distribution on SexEx5_4 among individuals with missing debut age #####
sexex5_4_summary_missing_debut_probsample_sens <- yin_partici5_only_probsample_sens %>%
  filter(is.na(sexual_debut_age)) %>%
  summarise(
    answered_1 = sum(SexEx5_4 == 1, na.rm = TRUE),
    answered_2 = sum(SexEx5_4 == 2, na.rm = TRUE),
    missing_SexEx5_4 = sum(is.na(SexEx5_4)),
    .groups = "drop"
  )

sexex5_4_summary_missing_debut_probsample_sens

##### Assigning debut age for individuals without reported debut who confirmed no debut at T5 #####
# Birth year is retrieved in the fixed priority order and converted to age in 2020

yin_partici5_only_probsample_sens <- yin_partici5_only_probsample_sens %>%
  mutate(
    birth_year_t5 = as.numeric(Birth5_3),
    birth_year_t4 = as.numeric(Birth4_3),
    birth_year_t3 = as.numeric(Birth3_3),
    assigned_debut_age = case_when(
      !is.na(birth_year_t5) ~ 2020 - birth_year_t5, #birth year reported as four digits (YYYY)
      is.na(birth_year_t5) & !is.na(birth_year_t4) ~ 120 - birth_year_t4, #birth year reported as two digits (YY)
      is.na(birth_year_t5) & is.na(birth_year_t4) & !is.na(birth_year_t3) ~ 120 - birth_year_t3, #birth year reported as two digits (YY)
      TRUE ~ NA_real_
    )
  )

##### Table of individuals with missing debut age and no debut confirmed at T5 #####
assigned_debut_table_probsample_sens <- yin_partici5_only_probsample_sens %>%
  filter(is.na(sexual_debut_age), SexEx5_4 == 2) %>%
  select(
    id,
    sexual_debut_age,
    SexEx5_4,
    Birth5_3,
    Birth4_3,
    Birth3_3,
    assigned_debut_age
  )

assigned_debut_table_probsample_sens

