make_outcome_plot <- function(outcome_name) {

  ggplot(
    filter(
      forest_panel_dat,
      outcome == outcome_name
    ),
    aes(
      x = timing,
      y = estimate,
      colour = timing
    )
  ) +
    geom_hline(
      yintercept = 0,
      linetype = "dashed",
      linewidth = 0.55
    ) +

    # Unadjusted confidence intervals
    geom_errorbar(
      data = filter(
        unadjusted_dat,
        outcome == outcome_name
      ),
      aes(
        ymin = conf_low,
        ymax = conf_high
      ),
      position = position_nudge(x = -0.23),
      width = 0.08,
      linewidth = 0.9,
      na.rm = TRUE,
      show.legend = FALSE
    ) +

    # Unadjusted estimates (squares)
    geom_point(
      data = filter(
        unadjusted_dat,
        outcome == outcome_name
      ),
      aes(shape = "Unadjusted"),
      position = position_nudge(x = -0.23),
      size = 3.3,
      show.legend = c(
        colour = FALSE,
        shape = TRUE
      )
    ) +

    # IPTW-adjusted confidence intervals
    geom_errorbar(
      aes(
        ymin = conf_low,
        ymax = conf_high
      ),
      width = 0.08,
      linewidth = 0.9,
      na.rm = TRUE
    ) +

    # IPTW-adjusted estimates (circles)
    geom_point(
      aes(shape = "IPTW-adjusted"),
      size = 3.3,
      show.legend = c(
        colour = TRUE,
        shape = TRUE
      )
    ) +

    scale_colour_manual(
      values = contrast_cols,
      limits = names(contrast_cols),
      drop = FALSE,
      name = NULL
    ) +

    scale_shape_manual(
      values = c(
        "Unadjusted" = 15,
        "IPTW-adjusted" = 16
      ),
      limits = c(
        "Unadjusted",
        "IPTW-adjusted"
      ),
      drop = FALSE,
      name = NULL
    ) +

    guides(
      colour = guide_legend(
        order = 1,
        nrow = 1,
        byrow = TRUE,
        override.aes = list(
          shape = 16
        )
      ),
      shape = guide_legend(
        order = 2,
        nrow = 1,
        byrow = TRUE,
        override.aes = list(
          colour = "black",
          size = 3.3
        )
      )
    ) +

    scale_x_discrete(
      drop = FALSE
    ) +

    scale_y_continuous(
      breaks = c(-10, -5, 0, 5, 10, 15),
      expand = expansion(
        mult = c(0.02, 0.02)
      )
    ) +

    coord_cartesian(
      ylim = c(-12, 19)
    ) +

    labs(
      title = outcome_name,
      x = NULL,
      y = NULL
    ) +

    theme_bw(
      base_size = 16,
      base_family = "Times New Roman"
    ) +

    theme(
      text = element_text(
        family = "Times New Roman",
        colour = "black"
      ),
      plot.title = element_text(
        family = "Times New Roman",
        size = 17,
        face = "plain",
        colour = "black",
        hjust = 0.5,
        margin = margin(b = 7)
      ),
      axis.text.x = element_blank(),
      axis.ticks.x = element_blank(),
      axis.text.y = element_text(
        family = "Times New Roman",
        size = 14,
        colour = "black"
      ),
      axis.ticks.y = element_line(
        linewidth = 0.45,
        colour = "black"
      ),
      panel.border = element_rect(
        linewidth = 0.55,
        colour = "black",
        fill = NA
      ),
      panel.grid.major.x = element_blank(),
      panel.grid.minor = element_blank(),
      panel.grid.major.y = element_line(
