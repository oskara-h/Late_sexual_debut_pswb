## 5) GT formatting

make_main_gt_wide_integrated_nodomain_probsample_sens <- function(df_wide,
                                                                  contrast_order = c("14 vs 18", "22 vs 18", "25 vs 18"),
                                                                  col_px = 160,
                                                                  outcome_px = 170,
                                                                  pad_px = 4) {
  
  width_fml <- function(lhs, width_num) {
    new_formula(
      lhs = ensym(lhs),
      rhs = expr(gt::px(!!as.integer(width_num)))
    )
  }
  
  delta_labs <- c(
    "14 vs 18" = "Δ 14 vs. 18 (95% CI)",
    "22 vs 18" = "Δ 22 vs. 18 (95% CI)",
    "25 vs 18" = "Δ 25 vs. 18 (95% CI)"
  )
  
  tab <- gt(df_wide) %>%
    cols_label(
      outcome = "Outcome",
      !!!delta_labs
    ) %>%
    cols_move_to_end(columns = all_of(contrast_order))
  
  tab <- do.call(cols_width, list(tab, width_fml(outcome, outcome_px)))
  
  for (cn in contrast_order) {
    tab <- do.call(
      cols_width,
      list(
        tab,
        new_formula(
          lhs = sym(cn),
          rhs = expr(gt::px(!!as.integer(col_px)))
        )
      )
    )
  }
  
  tab %>%
    tab_options(
      table.font.size  = 12,
      data_row.padding = gt::px(4),
      table.border.top.style    = "solid",
      table.border.top.width    = gt::px(1),
      table.border.top.color    = "black",
      table.border.bottom.style = "solid",
      table.border.bottom.width = gt::px(1),
      table.border.bottom.color = "black",
      column_labels.border.top.width    = gt::px(0),
      column_labels.border.bottom.width = gt::px(1),
      column_labels.border.bottom.color = "black",
      table_body.hlines.style = "none",
      table_body.border.top.width = gt::px(0),
      table_body.border.bottom.style = "none"
    ) %>%
    tab_style(
      style = cell_text(font = "Times New Roman", size = 12),
      locations = list(cells_body(), cells_column_labels(), cells_stub())
    ) %>%
    tab_style(
      style = cell_text(align = "left"),
      locations = list(
        cells_column_labels(columns = everything()),
        cells_body(columns = everything())
      )
    ) %>%
    tab_style(
      style = cell_text(indent = gt::px(pad_px)),
      locations = cells_body(columns = "outcome")
    ) %>%
    tab_source_note(
      source_note = "* 95% CI does not include 0 (\u03b1 = .05)."
    ) %>%
    tab_style(
      style = cell_borders(sides = "top", color = "black", weight = gt::px(1)),
      locations = cells_source_notes()
    )
}

