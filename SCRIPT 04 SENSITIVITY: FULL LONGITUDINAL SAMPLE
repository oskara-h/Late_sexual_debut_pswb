## 1) Build a long results object compatible with the old table-builder
##    IMPORTANT: effect_estimates_all_probsample_sens already scales binary outcomes to percentage points.
##    So we must NOT rescale again inside the table function.

results_for_table_probsample_sens <- effect_estimates_all_probsample_sens %>%
  filter(estimation == "IPTW-adjusted") %>%
  transmute(
    outcome   = as.character(outcome),
    contrast  = as.character(contrast),
    estimate  = as.numeric(estimate),
    conf_low_raw  = as.numeric(`2.5 %`),
    conf_high_raw = as.numeric(`97.5 %`)
  ) %>%
  mutate(
    # Ensure CI bounds are ordered correctly (critical after flipping early contrasts)
    conf_low  = pmin(conf_low_raw, conf_high_raw),
    conf_high = pmax(conf_low_raw, conf_high_raw)
  ) %>%
  select(outcome, contrast, estimate, conf_low, conf_high) %>%
  mutate(
    contrast = recode(
      contrast,
      "Early (14y)" = "14 vs 18",
      "Late (22y)"  = "22 vs 18",
      "Very late (25y)" = "25 vs 18"
    )
  ) %>%
  mutate(
    # Drop contrasts that are not defined / not supported for specific outcomes
    estimate  = if_else(outcome == "Illicit drug use" & contrast == "25 vs 18", NA_real_, estimate),
    conf_low  = if_else(outcome == "Illicit drug use" & contrast == "25 vs 18", NA_real_, conf_low),
