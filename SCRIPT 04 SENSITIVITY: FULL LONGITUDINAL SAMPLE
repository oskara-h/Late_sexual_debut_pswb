## 4) Wide table builder (NO internal scaling here)

make_contrast_table_wide_noscale_probsample_sens <- function(df,
                                                             outcome_order,
                                                             contrast_order = c("14 vs 18", "22 vs 18", "25 vs 18"),
                                                             digits = 2) {
  df %>%
    mutate(
      outcome  = factor(outcome, levels = outcome_order),
      contrast = factor(contrast, levels = contrast_order),
      sig = if_else(conf_low > 0 | conf_high < 0, "*", ""),
      cell = sprintf(
        paste0("%.", digits, "f (", "%.", digits, "f, %.", digits, "f)%s"),
        round(estimate,  digits),
        round(conf_low,  digits),
        round(conf_high, digits),
        sig
      )
    ) %>%
    select(outcome, contrast, cell) %>%
    pivot_wider(names_from = contrast, values_from = cell) %>%
    arrange(outcome) %>%
    mutate(across(-outcome, ~ tidyr::replace_na(.x, "")))
}

