### MULTINOMIAL PROPENSITY SCORE MODELS ###
positivity_models <- sexual_debut_data_imp_pos %>%
  group_by(.imp) %>%
  nest() %>%
  mutate(
    ps_model = map(
      data,
      ~ nnet::multinom(
        as.formula(paste0("debut_group ~ ", covariates)),
        data = .x,
        trace = FALSE
      )
    ),
    ps_pred = map2(
      ps_model, data,
      ~ tibble::as_tibble(
        predict(.x, newdata = .y, type = "probs")
      ) %>%
        bind_cols(
          .y %>% select(id, da_reported_or_assigned, debut_group)
        )
    )
  )

### COMBINE PROPENSITY SCORES ###
positivity_ps_long <- positivity_models %>%
  select(.imp, ps_pred) %>%
  unnest(ps_pred) %>%
  pivot_longer(
    cols = all_of(names(positivity_cols)),
    names_to = "ps_for_group",
    values_to = "propensity_score"
  ) %>%
  mutate(
    ps_for_group = factor(
      ps_for_group,
      levels = names(positivity_cols)
    )
  )

